# Variables públicas requeridas por el cliente Expo.
# La publishable key está diseñada para estar en el cliente; la seguridad real depende de RLS.
# Nunca agregues service_role ni secretos de servidor con prefijo EXPO_PUBLIC_.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

